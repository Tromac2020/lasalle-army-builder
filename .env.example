# Copy this file to .env and fill in your Supabase project's values
# (Supabase dashboard → Project Settings → API). The anon key is meant
# to be public/client-side — it is safe to ship in the built app.
#
# Without these set, the app still runs fine — the Account/save-load
# panel simply hides itself.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
